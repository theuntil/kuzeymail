# ---- Supabase ----
# SERVICE ROLE anahtarı gerekir: mail_claim_jobs yalnızca ona açık.
# Bu anahtar SİTEYE ASLA konulmaz, yalnızca bu serviste durur.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 465 kullanıyorsan true, 587 (STARTTLS) kullanıyorsan false
SMTP_SECURE=false

# ---- Site ----
# Maillerdeki bağlantılar bu adresle kurulur
SITE_URL=https://kuzeybatihaber.com.tr

# ---- HTTP API (isteğe bağlı) ----
# BOŞ BIRAKILIRSA /api/send hiç açılmaz — en güvenli mod.
# Servis yalnızca kuyruğu çeker, dışarıdan istek kabul etmez.
#
# Anahtar üretmek için:
#   openssl rand -hex 32
MAIL_API_KEY=

# Anahtar doğru olsa bile IP başına dakikada kaç istek
API_RATE_MAX=60

# İsteğe bağlı ikinci katman: yalnızca bu IP'lerden kabul et.
# Virgülle ayır. Anahtar sızsa bile başka yerden kullanılamaz.
API_ALLOW_IPS=

# ---- Çalışma ----
WORKER_NAME=mail-1
POLL_MS=15000
RECOVER_MINUTES=10
PORT=8080

# ---- Gönderen adresi ----
# BOŞ BIRAK: SMTP_USER kullanılır ve sunucu kesinlikle kabul eder.
#
# Çoğu SMTP sunucusu From adresinin kimlik doğrulanan hesaba ait
# olmasını zorunlu tutar:
#   553 5.7.1 Sender address rejected: not owned by user ...
#
# Sunucun alias destekliyorsa buraya o adresi yazabilirsin.
MAIL_FROM=

# ---- Cloudflare R2 (mail ekleri) ----------------------------
# Panel ek dosyaları R2'ye yüklüyor, servis gönderim anında
# indiriyor. Bu değerler yoksa EKLİ mailler gönderilemez
# (eksiz gönderilmez — hata verip kuyrukta bekler).
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=haber-medya
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
